
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )
        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD enter the existing DEV image tag, e.g. DEV-a1b2c3d'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_CREDENTIALS = 'AWS'

        AWS_ACCOUNT_ID = '552940445807'
        ECR_REGISTRY = 'https://552940445807.dkr.ecr.us-east-1.amazonaws.com'
        ECR_CREDENTIALS = 'ECR'

        DEV_ECR_REPO = 'app-1-dev-db'
        QA_ECR_REPO = 'app-1-qa-db'
        UAT_ECR_REPO = 'app-1-uat-db'
        PROD_ECR_REPO = 'app-1-prod-db'

        DEV_CLUSTER = 'app-1-dev-cluster'
        QA_CLUSTER = 'app-1-qa-cluster'
        UAT_CLUSTER = 'app-1-uat-cluster'
        PROD_CLUSTER = 'app-1-prod-cluster'

        DB_DEPLOYMENT = 'mysql'
        DB_CONTAINER = 'mysql'
        DB_SERVICE = 'app1-db'
    }

    stages {

        stage('Get Commit ID') {
            steps {
                script {
                    env.COMMIT_ID = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "COMMIT ID: ${env.COMMIT_ID}"

                    if (params.ENVIRONMENT == 'dev') {
                        env.DEV_TAG = "DEV-${env.COMMIT_ID}"
                        echo "DEV IMAGE TAG: ${env.DEV_TAG}"
                    } else {
                        if (!params.DEV_IMAGE_TAG?.trim()) {
                            error("DEV_IMAGE_TAG is required for ${params.ENVIRONMENT}")
                        }

                        if (!params.DEV_IMAGE_TAG.startsWith('DEV-')) {
                            error("DEV_IMAGE_TAG must start with DEV-, example: DEV-a1b2c3d")
                        }

                        env.DEV_TAG = params.DEV_IMAGE_TAG.trim()
                        echo "PROMOTING EXISTING DEV IMAGE: ${env.DEV_TAG}"
                    }
                }
            }
        }

        stage('Set Environment') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'dev') {
                        env.CLUSTER_NAME = env.DEV_CLUSTER
                        env.ECR_REPO = env.DEV_ECR_REPO
                        env.NAMESPACE = 'dev'
                        env.DEPLOY_TAG = env.DEV_TAG
                    }

                    if (params.ENVIRONMENT == 'qa') {
                        env.CLUSTER_NAME = env.QA_CLUSTER
                        env.ECR_REPO = env.QA_ECR_REPO
                        env.NAMESPACE = 'qa'
                        env.DEPLOY_TAG = "QA-${env.DEV_TAG.replaceFirst('DEV-', '')}"
                    }

                    if (params.ENVIRONMENT == 'uat') {
                        env.CLUSTER_NAME = env.UAT_CLUSTER
                        env.ECR_REPO = env.UAT_ECR_REPO
                        env.NAMESPACE = 'uat'
                        env.DEPLOY_TAG = "UAT-${env.DEV_TAG.replaceFirst('DEV-', '')}"
                    }

                    if (params.ENVIRONMENT == 'prod') {
                        env.CLUSTER_NAME = env.PROD_CLUSTER
                        env.ECR_REPO = env.PROD_ECR_REPO
                        env.NAMESPACE = 'prod'
                        env.DEPLOY_TAG = "PROD-${env.DEV_TAG.replaceFirst('DEV-', '')}"
                    }

                    echo "ENVIRONMENT : ${params.ENVIRONMENT}"
                    echo "CLUSTER     : ${env.CLUSTER_NAME}"
                    echo "NAMESPACE   : ${env.NAMESPACE}"
                    echo "ECR REPO    : ${env.ECR_REPO}"
                    echo "DEPLOY TAG  : ${env.DEPLOY_TAG}"
                }
            }
        }

        stage('Connect to EKS') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    sh '''
                        set -e

                        aws sts get-caller-identity

                        aws eks update-kubeconfig \
                            --name "${CLUSTER_NAME}" \
                            --region "${AWS_REGION}"

                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Create Kubernetes Namespace') {
            steps {
                sh '''
                    set -e

                    kubectl create namespace "${NAMESPACE}" \
                        --dry-run=client \
                        -o yaml | kubectl apply -f -

                    kubectl get namespace "${NAMESPACE}"
                '''
            }
        }

        stage('Build DB Image') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    docker.withRegistry("${ECR_REGISTRY}", "${ECR_CREDENTIALS}") {
                        sh '''
                            set -e

                            docker build \
                                -t "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR_REPO}:${DEV_TAG}" \
                                .

                            docker push \
                                "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR_REPO}:${DEV_TAG}"
                        '''
                    }
                }
            }
        }

        stage('Deploy DB - DEV') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    docker.withRegistry("${ECR_REGISTRY}", "${ECR_CREDENTIALS}") {
                        sh '''
                            set -e

                            kubectl apply -n "${NAMESPACE}" -f db-storageclass.yaml
                            kubectl apply -n "${NAMESPACE}" -f db-secret.yaml
                            kubectl apply -n "${NAMESPACE}" -f db-configmap.yaml
                            kubectl apply -n "${NAMESPACE}" -f db-pvc.yaml
                            kubectl apply -n "${NAMESPACE}" -f db-deployment.yaml
                            kubectl apply -n "${NAMESPACE}" -f db-service.yaml

                            kubectl set image \
                                deployment/"${DB_DEPLOYMENT}" \
                                "${DB_CONTAINER}"="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR_REPO}:${DEV_TAG}" \
                                -n "${NAMESPACE}"

                            kubectl rollout status \
                                deployment/"${DB_DEPLOYMENT}" \
                                -n "${NAMESPACE}" \
                                --timeout=10m

                            kubectl get storageclass
                            kubectl get secret -n "${NAMESPACE}"
                            kubectl get configmap -n "${NAMESPACE}"
                            kubectl get pvc -n "${NAMESPACE}"
                            kubectl get deployment "${DB_DEPLOYMENT}" -n "${NAMESPACE}"
                            kubectl get service "${DB_SERVICE}" -n "${NAMESPACE}"
                            kubectl get pods -n "${NAMESPACE}" -o wide
                        '''
                    }
                }
            }
        }

        stage('Promote DEV → QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                script {
                    docker.withRegistry("${ECR_REGISTRY}", "${ECR_CREDENTIALS}") {
                        sh '''
                            set -e

                            SOURCE_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR_REPO}:${DEV_TAG}"
                            TARGET_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${QA_ECR_REPO}:${DEPLOY_TAG}"

                            docker pull "${SOURCE_IMAGE}"
                            docker tag "${SOURCE_IMAGE}" "${TARGET_IMAGE}"
                            docker push "${TARGET_IMAGE}"

                            docker rmi "${SOURCE_IMAGE}" "${TARGET_IMAGE}" || true
                        '''
                    }
                }
            }
        }

        stage('Deploy DB - QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                sh '''
                    set -e

                    kubectl apply -n "${NAMESPACE}" -f db-storageclass.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-secret.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-configmap.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-pvc.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-deployment.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-service.yaml

                    kubectl set image \
                        deployment/"${DB_DEPLOYMENT}" \
                        "${DB_CONTAINER}"="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${QA_ECR_REPO}:${DEPLOY_TAG}" \
                        -n "${NAMESPACE}"

                    kubectl rollout status \
                        deployment/"${DB_DEPLOYMENT}" \
                        -n "${NAMESPACE}" \
                        --timeout=10m

                    kubectl get pvc -n "${NAMESPACE}"
                    kubectl get deployment "${DB_DEPLOYMENT}" -n "${NAMESPACE}"
                    kubectl get service "${DB_SERVICE}" -n "${NAMESPACE}"
                    kubectl get pods -n "${NAMESPACE}" -o wide
                '''
            }
        }

        stage('Promote QA → UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                script {
                    docker.withRegistry("${ECR_REGISTRY}", "${ECR_CREDENTIALS}") {
                        sh '''
                            set -e

                            SOURCE_TAG="${DEV_TAG}"
                            SOURCE_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${QA_ECR_REPO}:QA-${SOURCE_TAG.replaceFirst('DEV-', '')}"
                            TARGET_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${UAT_ECR_REPO}:${DEPLOY_TAG}"

                            docker pull "${SOURCE_IMAGE}"
                            docker tag "${SOURCE_IMAGE}" "${TARGET_IMAGE}"
                            docker push "${TARGET_IMAGE}"

                            docker rmi "${SOURCE_IMAGE}" "${TARGET_IMAGE}" || true
                        '''
                    }
                }
            }
        }

        stage('Deploy DB - UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                sh '''
                    set -e

                    kubectl apply -n "${NAMESPACE}" -f db-storageclass.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-secret.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-configmap.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-pvc.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-deployment.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-service.yaml

                    kubectl set image \
                        deployment/"${DB_DEPLOYMENT}" \
                        "${DB_CONTAINER}"="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${UAT_ECR_REPO}:${DEPLOY_TAG}" \
                        -n "${NAMESPACE}"

                    kubectl rollout status \
                        deployment/"${DB_DEPLOYMENT}" \
                        -n "${NAMESPACE}" \
                        --timeout=10m

                    kubectl get pvc -n "${NAMESPACE}"
                    kubectl get deployment "${DB_DEPLOYMENT}" -n "${NAMESPACE}"
                    kubectl get service "${DB_SERVICE}" -n "${NAMESPACE}"
                    kubectl get pods -n "${NAMESPACE}" -o wide
                '''
            }
        }

        stage('Production Approval') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: "Deploy DB image ${DEV_TAG} to PROD?",
                        ok: 'Deploy to PROD'
                    )
                }
            }
        }

        stage('Promote UAT → PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    docker.withRegistry("${ECR_REGISTRY}", "${ECR_CREDENTIALS}") {
                        sh '''
                            set -e

                            SOURCE_TAG="UAT-${DEV_TAG.replaceFirst('DEV-', '')}"
                            SOURCE_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${UAT_ECR_REPO}:${SOURCE_TAG}"
                            TARGET_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${PROD_ECR_REPO}:${DEPLOY_TAG}"

                            docker pull "${SOURCE_IMAGE}"
                            docker tag "${SOURCE_IMAGE}" "${TARGET_IMAGE}"
                            docker push "${TARGET_IMAGE}"

                            docker rmi "${SOURCE_IMAGE}" "${TARGET_IMAGE}" || true
                        '''
                    }
                }
            }
        }

        stage('Deploy DB - PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                sh '''
                    set -e

                    kubectl apply -n "${NAMESPACE}" -f db-storageclass.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-secret.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-configmap.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-pvc.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-deployment.yaml
                    kubectl apply -n "${NAMESPACE}" -f db-service.yaml

                    kubectl set image \
                        deployment/"${DB_DEPLOYMENT}" \
                        "${DB_CONTAINER}"="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${PROD_ECR_REPO}:${DEPLOY_TAG}" \
                        -n "${NAMESPACE}"

                    kubectl rollout status \
                        deployment/"${DB_DEPLOYMENT}" \
                        -n "${NAMESPACE}" \
                        --timeout=10m

                    kubectl get pvc -n "${NAMESPACE}"
                    kubectl get deployment "${DB_DEPLOYMENT}" -n "${NAMESPACE}"
                    kubectl get service "${DB_SERVICE}" -n "${NAMESPACE}"
                    kubectl get pods -n "${NAMESPACE}" -o wide
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

