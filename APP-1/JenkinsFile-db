
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )
        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD enter the existing DEV image tag, e.g. DEV-a1b2c3d'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CREDENTIALS = 'AWS'
        ECR_CREDENTIALS = 'ECR'

        DEV_CLUSTER = 'employee-mgm-dev-cluster'
        QA_CLUSTER = 'employee-mgm-qa-cluster'
        UAT_CLUSTER = 'employee-mgm-uat-cluster'
        PROD_CLUSTER = 'employee-mgm-prod-cluster'

        DEV_NAMESPACE = 'dev'
        QA_NAMESPACE = 'qa'
        UAT_NAMESPACE = 'uat'
        PROD_NAMESPACE = 'prod'

        DEV_ECR = 'employee-mgm-dev-db'
        QA_ECR = 'employee-mgm-qa-db'
        UAT_ECR = 'employee-mgm-uat-db'
        PROD_ECR = 'employee-mgm-prod-db'

        ECR_REGISTRY = 'https://552940445807.dkr.ecr.us-east-1.amazonaws.com'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Get Commit ID') {
            steps {
                script {
                    env.COMMIT_ID = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Commit ID: ${env.COMMIT_ID}"
                }
            }
        }

        stage('Build and Push DEV Image') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    env.DEV_IMAGE_TAG = "DEV-${COMMIT_ID}"

                    def image = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR}:${DEV_IMAGE_TAG}"

                    docker.withRegistry(ECR_REGISTRY, ECR_CREDENTIALS) {
                        sh """
                            docker build \
                            -t ${image} \
                            APP-1/nginx-flask-mysql/db/

                            docker push ${image}

                            docker image rm ${image} || true
                        """
                    }

                    echo "DEV image pushed: ${image}"
                }
            }
        }

        stage('Deploy DEV') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    def image = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR}:${DEV_IMAGE_TAG}"

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS]
                    ]) {
                        sh """
                            aws eks update-kubeconfig \
                            --name ${DEV_CLUSTER} \
                            --region ${AWS_REGION}

                            kubectl create namespace ${DEV_NAMESPACE} \
                            --dry-run=client \
                            -o yaml | kubectl apply -f -

                            kubectl apply \
                            -f APP-1/kube/db-storageclass.yaml

                            kubectl apply \
                            -f APP-1/kube/db-secret.yaml \
                            -n ${DEV_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-configmap.yaml \
                            -n ${DEV_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-pvc.yaml \
                            -n ${DEV_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-deployment.yaml \
                            -n ${DEV_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-service.yaml \
                            -n ${DEV_NAMESPACE}

                            kubectl -n ${DEV_NAMESPACE} \
                            set image deployment/mysql \
                            mysql=${image}

                            kubectl -n ${DEV_NAMESPACE} \
                            rollout status deployment/mysql \
                            --timeout=300s

                            kubectl -n ${DEV_NAMESPACE} get pods
                            kubectl -n ${DEV_NAMESPACE} get svc
                            kubectl -n ${DEV_NAMESPACE} get pvc
                        """
                    }
                }
            }
        }

        stage('Promote DEV Image to QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                script {
                    if (!params.DEV_IMAGE_TAG?.trim()) {
                        error('DEV_IMAGE_TAG is required for QA deployment')
                    }

                    def sourceImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR}:${params.DEV_IMAGE_TAG}"
                    def targetImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${QA_ECR}:QA-${params.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"

                    env.TARGET_IMAGE = targetImage

                    docker.withRegistry(ECR_REGISTRY, ECR_CREDENTIALS) {
                        sh """
                            docker pull ${sourceImage}

                            docker tag \
                            ${sourceImage} \
                            ${targetImage}

                            docker push ${targetImage}

                            docker image rm ${sourceImage} || true
                            docker image rm ${targetImage} || true
                        """
                    }

                    echo "QA image pushed: ${targetImage}"
                }
            }
        }

        stage('Deploy QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                script {
                    def image = env.TARGET_IMAGE

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS]
                    ]) {
                        sh """
                            aws eks update-kubeconfig \
                            --name ${QA_CLUSTER} \
                            --region ${AWS_REGION}

                            kubectl create namespace ${QA_NAMESPACE} \
                            --dry-run=client \
                            -o yaml | kubectl apply -f -

                            kubectl apply \
                            -f APP-1/kube/db-storageclass.yaml

                            kubectl apply \
                            -f APP-1/kube/db-secret.yaml \
                            -n ${QA_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-configmap.yaml \
                            -n ${QA_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-pvc.yaml \
                            -n ${QA_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-deployment.yaml \
                            -n ${QA_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-service.yaml \
                            -n ${QA_NAMESPACE}

                            kubectl -n ${QA_NAMESPACE} \
                            set image deployment/mysql \
                            mysql=${image}

                            kubectl -n ${QA_NAMESPACE} \
                            rollout status deployment/mysql \
                            --timeout=300s

                            kubectl -n ${QA_NAMESPACE} get pods
                            kubectl -n ${QA_NAMESPACE} get svc
                            kubectl -n ${QA_NAMESPACE} get pvc
                        """
                    }
                }
            }
        }

        stage('Promote DEV Image to UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                script {
                    if (!params.DEV_IMAGE_TAG?.trim()) {
                        error('DEV_IMAGE_TAG is required for UAT deployment')
                    }

                    def sourceImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR}:${params.DEV_IMAGE_TAG}"
                    def targetImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${UAT_ECR}:UAT-${params.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"

                    env.TARGET_IMAGE = targetImage

                    docker.withRegistry(ECR_REGISTRY, ECR_CREDENTIALS) {
                        sh """
                            docker pull ${sourceImage}

                            docker tag \
                            ${sourceImage} \
                            ${targetImage}

                            docker push ${targetImage}

                            docker image rm ${sourceImage} || true
                            docker image rm ${targetImage} || true
                        """
                    }

                    echo "UAT image pushed: ${targetImage}"
                }
            }
        }

        stage('Deploy UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                script {
                    def image = env.TARGET_IMAGE

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS]
                    ]) {
                        sh """
                            aws eks update-kubeconfig \
                            --name ${UAT_CLUSTER} \
                            --region ${AWS_REGION}

                            kubectl create namespace ${UAT_NAMESPACE} \
                            --dry-run=client \
                            -o yaml | kubectl apply -f -

                            kubectl apply \
                            -f APP-1/kube/db-storageclass.yaml

                            kubectl apply \
                            -f APP-1/kube/db-secret.yaml \
                            -n ${UAT_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-configmap.yaml \
                            -n ${UAT_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-pvc.yaml \
                            -n ${UAT_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-deployment.yaml \
                            -n ${UAT_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-service.yaml \
                            -n ${UAT_NAMESPACE}

                            kubectl -n ${UAT_NAMESPACE} \
                            set image deployment/mysql \
                            mysql=${image}

                            kubectl -n ${UAT_NAMESPACE} \
                            rollout status deployment/mysql \
                            --timeout=300s

                            kubectl -n ${UAT_NAMESPACE} get pods
                            kubectl -n ${UAT_NAMESPACE} get svc
                            kubectl -n ${UAT_NAMESPACE} get pvc
                        """
                    }
                }
            }
        }

        stage('Production Approval') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                input message: 'Approve deployment to PROD?', ok: 'Deploy PROD'
            }
        }

        stage('Promote DEV Image to PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    if (!params.DEV_IMAGE_TAG?.trim()) {
                        error('DEV_IMAGE_TAG is required for PROD deployment')
                    }

                    def sourceImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${DEV_ECR}:${params.DEV_IMAGE_TAG}"
                    def targetImage = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${PROD_ECR}:PROD-${params.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"

                    env.TARGET_IMAGE = targetImage

                    docker.withRegistry(ECR_REGISTRY, ECR_CREDENTIALS) {
                        sh """
                            docker pull ${sourceImage}

                            docker tag \
                            ${sourceImage} \
                            ${targetImage}

                            docker push ${targetImage}

                            docker image rm ${sourceImage} || true
                            docker image rm ${targetImage} || true
                        """
                    }

                    echo "PROD image pushed: ${targetImage}"
                }
            }
        }

        stage('Deploy PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    def image = env.TARGET_IMAGE

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS]
                    ]) {
                        sh """
                            aws eks update-kubeconfig \
                            --name ${PROD_CLUSTER} \
                            --region ${AWS_REGION}

                            kubectl create namespace ${PROD_NAMESPACE} \
                            --dry-run=client \
                            -o yaml | kubectl apply -f -

                            kubectl apply \
                            -f APP-1/kube/db-storageclass.yaml

                            kubectl apply \
                            -f APP-1/kube/db-secret.yaml \
                            -n ${PROD_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-configmap.yaml \
                            -n ${PROD_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-pvc.yaml \
                            -n ${PROD_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-deployment.yaml \
                            -n ${PROD_NAMESPACE}

                            kubectl apply \
                            -f APP-1/kube/db-service.yaml \
                            -n ${PROD_NAMESPACE}

                            kubectl -n ${PROD_NAMESPACE} \
                            set image deployment/mysql \
                            mysql=${image}

                            kubectl -n ${PROD_NAMESPACE} \
                            rollout status deployment/mysql \
                            --timeout=300s

                            kubectl -n ${PROD_NAMESPACE} get pods
                            kubectl -n ${PROD_NAMESPACE} get svc
                            kubectl -n ${PROD_NAMESPACE} get pvc
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

