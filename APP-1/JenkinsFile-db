
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )

        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD enter the existing DEV image tag, e.g. DEV-a1b2c3d'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_CREDENTIALS = 'AWS'
        AWS_ACCOUNT_ID = '552940445807'

        DEV_ECR_REPO = 'app-1-dev-db'
        QA_ECR_REPO = 'app-1-qa-db'
        UAT_ECR_REPO = 'app-1-uat-db'
        PROD_ECR_REPO = 'app-1-prod-db'

        DEV_CLUSTER = 'app-1-dev-cluster'
        QA_CLUSTER = 'app-1-qa-cluster'
        UAT_CLUSTER = 'app-1-uat-cluster'
        PROD_CLUSTER = 'app-1-prod-cluster'

        DB_DEPLOYMENT = 'mysql'
        DB_CONTAINER = 'mysql'
        DB_SERVICE = 'app1-db'

        DB_DOCKER_PATH = 'APP-1/nginx-flask-mysql/db'
        KUBE_PATH = 'APP-1/kube'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Get Commit ID') {
            steps {
                script {
                    getCommitId()
                }
            }
        }

        stage('Set Environment') {
            steps {
                script {
                    setEnvironment()
                }
            }
        }

        stage('Connect to EKS') {
            steps {
                script {
                    connectToEKS()
                }
            }
        }

        stage('Create Kubernetes Namespace') {
            steps {
                script {
                    createNamespace()
                }
            }
        }

        stage('Build DB Image') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    buildDBImage()
                }
            }
        }

        stage('Deploy DB - DEV') {
            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }
            steps {
                script {
                    deployDB(env.DEV_ECR_REPO)
                }
            }
        }

        stage('Promote DEV → QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                script {
                    promoteImage(
                        env.DEV_ECR_REPO,
                        env.DEV_TAG,
                        env.QA_ECR_REPO,
                        env.DEPLOY_TAG
                    )
                }
            }
        }

        stage('Deploy DB - QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }
            steps {
                script {
                    deployDB(env.QA_ECR_REPO)
                }
            }
        }

        stage('Promote QA → UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                script {
                    promoteImage(
                        env.QA_ECR_REPO,
                        "QA-${env.DEV_TAG.replaceFirst('DEV-', '')}",
                        env.UAT_ECR_REPO,
                        env.DEPLOY_TAG
                    )
                }
            }
        }

        stage('Deploy DB - UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }
            steps {
                script {
                    deployDB(env.UAT_ECR_REPO)
                }
            }
        }

        stage('Production Approval') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    productionApproval()
                }
            }
        }

        stage('Promote UAT → PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    promoteImage(
                        env.UAT_ECR_REPO,
                        "UAT-${env.DEV_TAG.replaceFirst('DEV-', '')}",
                        env.PROD_ECR_REPO,
                        env.DEPLOY_TAG
                    )
                }
            }
        }

        stage('Deploy DB - PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }
            steps {
                script {
                    deployDB(env.PROD_ECR_REPO)
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning Jenkins workspace...'
            cleanWs()
        }
    }
}

def getCommitId() {

    env.COMMIT_ID = sh(
        script: 'git rev-parse --short HEAD',
        returnStdout: true
    ).trim()

    echo "COMMIT ID: ${env.COMMIT_ID}"

    if (params.ENVIRONMENT == 'dev') {

        env.DEV_TAG = "DEV-${env.COMMIT_ID}"

        echo "DEV IMAGE TAG: ${env.DEV_TAG}"

    } else {

        if (!params.DEV_IMAGE_TAG?.trim()) {
            error("DEV_IMAGE_TAG is required for ${params.ENVIRONMENT}")
        }

        if (!params.DEV_IMAGE_TAG.startsWith('DEV-')) {
            error(
                "DEV_IMAGE_TAG must start with DEV-, example: DEV-a1b2c3d"
            )
        }

        env.DEV_TAG = params.DEV_IMAGE_TAG.trim()

        echo "PROMOTING EXISTING DEV IMAGE: ${env.DEV_TAG}"
    }
}

def setEnvironment() {

    if (params.ENVIRONMENT == 'dev') {

        env.CLUSTER_NAME = env.DEV_CLUSTER
        env.ECR_REPO = env.DEV_ECR_REPO
        env.NAMESPACE = 'dev'
        env.DEPLOY_TAG = env.DEV_TAG

    } else if (params.ENVIRONMENT == 'qa') {

        env.CLUSTER_NAME = env.QA_CLUSTER
        env.ECR_REPO = env.QA_ECR_REPO
        env.NAMESPACE = 'qa'
        env.DEPLOY_TAG = "QA-${env.DEV_TAG.replaceFirst('DEV-', '')}"

    } else if (params.ENVIRONMENT == 'uat') {

        env.CLUSTER_NAME = env.UAT_CLUSTER
        env.ECR_REPO = env.UAT_ECR_REPO
        env.NAMESPACE = 'uat'
        env.DEPLOY_TAG = "UAT-${env.DEV_TAG.replaceFirst('DEV-', '')}"

    } else if (params.ENVIRONMENT == 'prod') {

        env.CLUSTER_NAME = env.PROD_CLUSTER
        env.ECR_REPO = env.PROD_ECR_REPO
        env.NAMESPACE = 'prod'
        env.DEPLOY_TAG = "PROD-${env.DEV_TAG.replaceFirst('DEV-', '')}"

    } else {
        error("Invalid environment: ${params.ENVIRONMENT}")
    }

    echo "ENVIRONMENT : ${params.ENVIRONMENT}"
    echo "CLUSTER     : ${env.CLUSTER_NAME}"
    echo "NAMESPACE   : ${env.NAMESPACE}"
    echo "ECR REPO    : ${env.ECR_REPO}"
    echo "DEPLOY TAG  : ${env.DEPLOY_TAG}"
}

def connectToEKS() {

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CREDENTIALS}"
        ]
    ]) {

        sh '''
            set -e

            echo "Checking AWS credentials..."
            aws sts get-caller-identity

            echo "Connecting to EKS..."
            echo "Cluster: ${CLUSTER_NAME}"
            echo "Region : ${AWS_REGION}"

            aws eks update-kubeconfig \
                --name "${CLUSTER_NAME}" \
                --region "${AWS_REGION}"

            echo "Kubernetes nodes:"
            kubectl get nodes
        '''
    }
}

def createNamespace() {

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CREDENTIALS}"
        ]
    ]) {

        sh '''
            set -e

            echo "Creating namespace: ${NAMESPACE}"

            kubectl create namespace "${NAMESPACE}" \
                --dry-run=client \
                -o yaml | kubectl apply -f -

            echo "Namespace:"
            kubectl get namespace "${NAMESPACE}"
        '''
    }
}

def buildDBImage() {

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CREDENTIALS}"
        ]
    ]) {

        sh '''
            set -e

            REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

            IMAGE="${REGISTRY}/${DEV_ECR_REPO}:${DEV_TAG}"

            echo "Authenticating Docker with ECR..."

            aws ecr get-login-password \
                --region "${AWS_REGION}" |
                docker login \
                --username AWS \
                --password-stdin "${REGISTRY}"

            echo "Building DB image..."

            echo "Docker build path:"
            echo "${DB_DOCKER_PATH}"

            echo "Image:"
            echo "${IMAGE}"

            docker build \
                -t "${IMAGE}" \
                "${DB_DOCKER_PATH}"

            echo "Pushing DB image..."

            docker push "${IMAGE}"

            echo "DEV image pushed successfully."

            docker logout "${REGISTRY}"
        '''
    }
}

def deployDB(String environmentRepo) {

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CREDENTIALS}"
        ]
    ]) {

        sh """
            set -e

            REGISTRY="${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

            IMAGE="\${REGISTRY}/${environmentRepo}:${env.DEPLOY_TAG}"

            KUBE_PATH="${env.KUBE_PATH}"

            echo "Deploying DB image:"
            echo "\${IMAGE}"

            echo "Kubernetes manifest path:"
            echo "\${KUBE_PATH}"

            echo "Applying StorageClass..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-storageclass.yaml"

            echo "Applying Secret..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-secret.yaml"

            echo "Applying ConfigMap..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-configmap.yaml"

            echo "Applying PVC..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-pvc.yaml"

            echo "Applying Deployment..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-deployment.yaml"

            echo "Applying Service..."

            kubectl apply \
                -n "${env.NAMESPACE}" \
                -f "\${KUBE_PATH}/db-service.yaml"

            echo "Updating DB image..."

            kubectl set image \
                deployment/${env.DB_DEPLOYMENT} \
                ${env.DB_CONTAINER}="\${IMAGE}" \
                -n "${env.NAMESPACE}"

            echo "Waiting for deployment rollout..."

            kubectl rollout status \
                deployment/${env.DB_DEPLOYMENT} \
                -n "${env.NAMESPACE}" \
                --timeout=10m

            echo "StorageClass:"
            kubectl get storageclass

            echo "Secret:"
            kubectl get secret \
                -n "${env.NAMESPACE}"

            echo "ConfigMap:"
            kubectl get configmap \
                -n "${env.NAMESPACE}"

            echo "PVC:"
            kubectl get pvc \
                -n "${env.NAMESPACE}"

            echo "Deployment:"
            kubectl get deployment \
                "${env.DB_DEPLOYMENT}" \
                -n "${env.NAMESPACE}"

            echo "Service:"
            kubectl get service \
                "${env.DB_SERVICE}" \
                -n "${env.NAMESPACE}"

            echo "Pods:"
            kubectl get pods \
                -n "${env.NAMESPACE}" \
                -o wide
        """
    }
}

def promoteImage(
    String sourceRepo,
    String sourceTag,
    String targetRepo,
    String targetTag
) {

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CREDENTIALS}"
        ]
    ]) {

        sh """
            set -e

            REGISTRY="${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

            SOURCE_IMAGE="\${REGISTRY}/${sourceRepo}:${sourceTag}"

            TARGET_IMAGE="\${REGISTRY}/${targetRepo}:${targetTag}"

            echo "Authenticating Docker with ECR..."

            aws ecr get-login-password \
                --region "${env.AWS_REGION}" |
                docker login \
                --username AWS \
                --password-stdin "\${REGISTRY}"

            echo "Source image:"
            echo "\${SOURCE_IMAGE}"

            echo "Target image:"
            echo "\${TARGET_IMAGE}"

            echo "Pulling source image..."

            docker pull "\${SOURCE_IMAGE}"

            echo "Tagging image..."

            docker tag \
                "\${SOURCE_IMAGE}" \
                "\${TARGET_IMAGE}"

            echo "Pushing target image..."

            docker push "\${TARGET_IMAGE}"

            echo "Image promotion completed successfully."

            docker rmi \
                "\${SOURCE_IMAGE}" \
                "\${TARGET_IMAGE}" || true

            docker logout "\${REGISTRY}"
        """
    }
}

def productionApproval() {

    timeout(time: 30, unit: 'MINUTES') {

        input(
            message: "Deploy DB image ${env.DEV_TAG} to PROD?",
            ok: 'Deploy to PROD'
        )
    }
}
